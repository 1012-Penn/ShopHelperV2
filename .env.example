MODEL=deepseek-chat
API_KEY=
DEEPSEEK_API_KEY=
BASE_URL=https://api.deepseek.com
DATABASE_URL=mysql+pymysql://mewhelp:mewhelp@127.0.0.1:3306/mewhelp
TOOL_TIMEOUT_SECONDS=5
TOOL_MAX_RETRIES=2
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=knowledge
KNOWLEDGE_MAX_CHARS=1200
KNOWLEDGE_OVERLAP_CHARS=200
FAQ_TOP_K=5
FAQ_MIN_SIMILARITY=0.60
KNOWLEDGE_BATCH_SIZE=32

# ch04: run migrate_ch04 and rebuild_hybrid_index before enabling
QUALITY_ENABLED=true
HYBRID_COLLECTION=knowledge_ch04
RERANK_API_BASE=https://api.siliconflow.cn/v1
