MODEL=deepseek-chat
API_KEY=
DEEPSEEK_API_KEY=
BASE_URL=https://api.deepseek.com
DATABASE_URL=mysql+pymysql://mewhelp:mewhelp@127.0.0.1:3306/mewhelp
TOOL_TIMEOUT_SECONDS=5
TOOL_MAX_RETRIES=2
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=knowledge
KNOWLEDGE_MAX_CHARS=1200
KNOWLEDGE_OVERLAP_CHARS=200
FAQ_TOP_K=5
FAQ_MIN_SIMILARITY=0.60
KNOWLEDGE_BATCH_SIZE=32

# ch04: run migrate_ch04 and rebuild_hybrid_index before enabling
QUALITY_ENABLED=true
HYBRID_COLLECTION=knowledge_ch04
RERANK_API_BASE=https://api.siliconflow.cn/v1
RERANK_API_KEY=
# Baseline calibration selected 0.05; recalibrate for your production corpus
RERANK_MIN_SCORE=0.05
QUALITY_GENERATION_DIAGNOSTICS_PATH=.runtime/quality/generation-failures.jsonl

# ch05: single-process workflow persistence and bounded agent
WORKFLOW_CHECKPOINT_PATH=.runtime/ch05/checkpoints.sqlite
WORKFLOW_LOG_PATH=.runtime/ch05/workflow.jsonl
MAX_AGENT_STEPS=4
AGENT_MAX_TOOL_CALLS=6
MAX_OUTPUT_TOKENS=2000
AGENT_MAX_TOKENS=1000000

# Optional evaluation judge; empty fields reuse the generator configuration.
# --require-independent-judge rejects missing or identical effective identities.
# Endpoint/model configuration differences do not prove training independence.
JUDGE_MODEL=
JUDGE_API_BASE=
JUDGE_API_KEY=

# Chapter 7: model window (single-call capacity, independent of cumulative API cost)
MODEL_CONTEXT_WINDOW=128000
MAX_USER_INPUT_TOKENS=2000
TOOL_RESULT_MAX_TOKENS=1200
RERANK_TOP_K=5
CONTEXT_TARGET_TURNS=40
CONTEXT_STEADY_TURN_TOKENS=2000
CONTEXT_SYSTEM_TOOLS_TOKENS=2200
CONTEXT_EVIDENCE_ITEM_TOKENS=150
CONTEXT_SUMMARY_TOKENS=1000
CONTEXT_SAFETY_TOKENS=500
CONTEXT_DECISION_TOKENS=100
CHINESE_TOKEN_RATIO=1.0
CONTEXT_ASSISTANT_CHARS=60
CONTEXT_LOG_PATH=log/app.log

# Chapter 8: independent mock MCP servers (Streamable HTTP)
MCP_LOGISTICS_URL=http://127.0.0.1:8765/mcp
MCP_AFTER_SALE_URL=http://127.0.0.1:8766/mcp
MCP_DISCOVERY_TIMEOUT_SECONDS=5
LOGISTICS_MCP_PORT=8765
AFTER_SALE_MCP_PORT=8766
MCP_ENABLED=true
TOOL_PERMISSIONS_PATH=config/tool_permissions.json
